<?xml version="1.0" encoding="UTF-8" ?>
<component type="desktop-application">
  <id>com.nichokas.SDAT.Desktop</id>
  <provides><id>dev.dergs.Tonearm</id></provides>
  <replaces><id>dev.dergs.Tonearm</id></replaces>
  <metadata_license>MIT</metadata_license>
  <name>SDAT</name>
  <summary>Stream your favorite music</summary>
  <description>
    <p>
    With SDAT you are able to play tracks at their highest quality, explore new tracks using discovery mixes or the explore tab or just enjoy the songs you already know you love from your collection. Just like you would expect from the real app. SDAT also has some additional features such as
    </p>
    <ul>
      <li>Background Playback</li>
      <li>Gapless playback</li>
      <li>MPRIS integration</li>
      <li>Scrobbling to ListenBrainz and Last.fm</li>
    </ul>
    <p>
    Don't have a TIDAL account? You can still try the app and enjoy song previews of up to 30 seconds to see if it's for you.
    </p>
  </description>
  <icon type="stock">com.nichokas.SDAT.Desktop</icon>

  <categories>
      <category>Audio</category>
      <category>AudioVideo</category>
      <category>Music</category>
  </categories>

  <keywords>
    <keyword translate="no">TIDAL</keyword>
    <keyword translate="no">MPRIS</keyword>
    <keyword translate="no">ListenBrainz</keyword>
    <keyword translate="no">Last.fm</keyword>
    <keyword>music</keyword>
    <keyword>streaming</keyword>
  </keywords>

  <branding>
    <color type="primary" scheme_preference="light">#3a2aef</color>
    <color type="primary" scheme_preference="dark">#690daf</color>
  </branding>

  <!-- SDAT desktop: Rust port (formerly tonearm-rs) of the original Tonearm by the dergs team: https://codeberg.org/dergs/Tonearm -->
  <url type="homepage">https://github.com/Nichokas/SDAT</url>
  <url type="bugtracker">https://github.com/Nichokas/SDAT/issues</url>
  <url type="vcs-browser">https://github.com/Nichokas/SDAT</url>

  <releases>
    <release version="1.2.3" date="2026-11-02">
        <url type="details">https://github.com/Nichokas/SDAT/releases/tag/desktop-v1.2.3</url>
        <description>
            <p>Listen Together sync fixes:</p>
            <ul>
                <li>Guests no longer start a new track at the previous track's position</li>
                <li>Guests start playback aligned with the host's position</li>
                <li>Host seeks reach guests faster, and guests can seek</li>
            </ul>
        </description>
    </release>
    <release version="1.2.2" date="2026-11-02">
        <url type="details">https://github.com/Nichokas/SDAT/releases/tag/desktop-v1.2.2</url>
        <description>
            <ul>
                <li>Listen Together: guests can control playback when the host allows it</li>
                <li>New "Play Next" option in queue menus</li>
                <li>Listen Together sync no longer changes the playback speed to catch up</li>
                <li>More stable playback start for Listen Together guests</li>
            </ul>
        </description>
    </release>
    <release version="1.2.0" date="2026-11-02">
        <url type="details">https://github.com/Nichokas/SDAT/releases/tag/desktop-v1.2.0</url>
        <description>
            <p>First SDAT desktop release (formerly tonearm-rs), now built from the SDAT monorepo.</p>
        </description>
    </release>
  </releases>

  <launchable type="desktop-id">com.nichokas.SDAT.Desktop.desktop</launchable>

  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </recommends>

  <project_license>GPL-3.0-or-later</project_license>

  <developer id="dev.dergs">
    <name translate="no">The Dergs and Contributors</name>
  </developer>

